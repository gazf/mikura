{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read=./src/ui --allow-env src/main.ts",
    "start": "deno run --allow-net --allow-read=./src/ui --allow-env src/main.ts",
    "test": "deno test --allow-net --allow-read --allow-env tests/",
    "check": "deno check src/main.ts"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4",
    "@hono/hono": "jsr:@hono/hono@^4",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "strict": true
  }
}
